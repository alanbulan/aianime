{
  "name": "@ai-anime/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "node scripts/clean-dist.mjs && tsc -b && vite build",
    "build:ce": "node scripts/clean-dist.mjs && tsc -b && vite build --mode ce",
    "preview": "vite preview",
    "test": "node run-test-projects.mjs",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:browser": "vitest run --project browser",
    "test:browser:install": "playwright install chromium",
    "test:architecture": "vitest run src/__tests__/architecture",
    "test:watch": "vitest"
  },
